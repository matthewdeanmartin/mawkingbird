{
  "name": "ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node scripts/import-starter-catalog.mjs --check && node scripts/vendor-analytics.mjs",
    "build": "ng build",
    "prebuild:mockingbird": "node scripts/import-starter-catalog.mjs --check && node scripts/vendor-analytics.mjs",
    "build:mockingbird": "ng build --configuration mockingbird",
    "postbuild:mockingbird": "node scripts/check-mock-leakage.mjs",
    "vendor:analytics": "node scripts/vendor-analytics.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "node scripts/run-audited-tests.mjs --coverage",
    "test:audit": "node scripts/run-audited-tests.mjs",
    "test:audit:update": "node scripts/run-audited-tests.mjs --update",
    "test:subset": "node scripts/run-test-subset.mjs",
    "test:source-integrity": "node scripts/check-test-integrity.mjs",
    "lint": "ng lint ui --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss}\"",
    "servers:snapshot": "node scripts/update-server-snapshot.mjs",
    "check:storage": "node scripts/check-storage-registry.mjs",
    "check:terminology": "node scripts/check-terminology.mjs",
    "i18n:extract": "node scripts/extract-i18n.mjs",
    "i18n:todo": "node scripts/i18n-todo.mjs",
    "i18n:batch": "node scripts/i18n-batch.mjs",
    "i18n:merge": "node scripts/i18n-merge.mjs",
    "i18n:traps": "node scripts/i18n-traps.mjs",
    "check:i18n": "node scripts/extract-i18n.mjs --check && node scripts/check-i18n.mjs",
    "check:static": "npm run check:storage && npm run check:subpaths && npm run check:i18n && npm run starter-kits:check && npm run format:check",
    "check:known-failing": "npm run check:terminology && npm run test:source-integrity",
    "check": "npm run check:static && npm run lint && npm run test:ci",
    "gen:api-docs": "node scripts/gen-api-docs.mjs",
    "starter-kits:update": "node scripts/update-bundled-starter-kits.mjs",
    "starter-catalog:update": "node scripts/import-starter-catalog.mjs",
    "starter-catalog:check": "node scripts/import-starter-catalog.mjs --check",
    "starter-kits:check": "node scripts/update-bundled-starter-kits.mjs --check",
    "check:subpaths": "node scripts/check-subpath-deployments.mjs",
    "check:mock-leakage": "node scripts/check-mock-leakage.mjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^21.2.21",
    "@angular/compiler": "^21.2.21",
    "@angular/core": "^21.2.21",
    "@angular/forms": "^21.2.21",
    "@angular/platform-browser": "^21.2.21",
    "@angular/router": "^21.2.21",
    "@atproto/oauth-client-browser": "^0.5.3",
    "@emoji-mart/data": "^1.2.1",
    "@jsverse/transloco": "^8.4.0",
    "@mozilla/readability": "^0.6.0",
    "badwords-list": "^2.0.1-4",
    "emoji-mart": "^5.6.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.0.0",
    "@angular/build": "^21.2.21",
    "@angular/cli": "^21.2.21",
    "@angular/compiler-cli": "^21.2.21",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "angular-eslint": "^21.0.0",
    "eslint": "^10.0.3",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.9"
  }
}
