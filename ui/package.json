{
  "name": "ui",
  "version": "0.0.0",
  "scripts": {
    "design:dev": "ng run ui:storybook",
    "design:lint": "stylelint --config ../design_system/stylelint.config.mjs \"src/app/design-system/**/*.css\" ../design_system/preview.css ../design_system/tokens.css && node --test ../design_system/rules/*.test.mjs",
    "design:audit-colors": "node scripts/audit-design-colors.mjs",
    "design:browser": "playwright test --config ../design_system/playwright.config.mjs",
    "design:verify": "npm run design:check && npm run design:lint && npm run design:build && npm run design:browser",
    "design:build": "ng run ui:build-storybook --quiet",
    "design:format": "prettier --ignore-path ../design_system/.prettierignore --write \"../design_system/**/*.{ts,mjs,css,json,md}\" \"src/app/design-system/**/*.{ts,html,css}\" \"scripts/*design*.mjs\"",
    "design:check": "prettier --ignore-path ../design_system/.prettierignore --check \"../design_system/**/*.{ts,mjs,css,json,md}\" \"src/app/design-system/**/*.{ts,html,css}\" \"scripts/*design*.mjs\" && tsc --project ../design_system/.storybook/tsconfig.json --noEmit",
    "design:test": "npm run test:subset -- src/app/design-system",
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node scripts/import-starter-catalog.mjs --check && node scripts/vendor-analytics.mjs",
    "build": "ng build",
    "prebuild:mockingbird": "node scripts/import-starter-catalog.mjs --check && node scripts/vendor-analytics.mjs",
    "build:mockingbird": "ng build --configuration mockingbird --stats-json",
    "postbuild:mockingbird": "node scripts/check-mock-leakage.mjs && node scripts/report-bundle.mjs --check",
    "bundle:report": "node scripts/report-bundle.mjs",
    "vendor:analytics": "node scripts/vendor-analytics.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "node scripts/run-audited-tests.mjs --coverage",
    "test:integration": "bash scripts/run-integration.sh",
    "test:audit": "node scripts/run-audited-tests.mjs",
    "test:audit:update": "node scripts/run-audited-tests.mjs --update",
    "test:subset": "node scripts/run-test-subset.mjs",
    "test:source-integrity": "node scripts/check-test-integrity.mjs && node --test scripts/report-bundle.test.mjs",
    "lint": "ng lint ui --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss}\"",
    "servers:snapshot": "node scripts/update-server-snapshot.mjs",
    "check:storage": "node scripts/check-storage-registry.mjs",
    "check:terminology": "node scripts/check-terminology.mjs",
    "i18n:extract": "node scripts/extract-i18n.mjs",
    "i18n:todo": "node scripts/i18n-todo.mjs",
    "i18n:batch": "node scripts/i18n-batch.mjs",
    "i18n:merge": "node scripts/i18n-merge.mjs",
    "i18n:traps": "node scripts/i18n-traps.mjs",
    "check:i18n": "node scripts/extract-i18n.mjs --check && node scripts/check-i18n.mjs",
    "check:static": "npm run check:storage && npm run check:subpaths && npm run check:i18n && npm run starter-kits:check && npm run format:check && npm run design:lint",
    "check:known-failing": "npm run check:terminology && npm run test:source-integrity",
    "check": "npm run check:static && npm run lint && npm run test:ci",
    "gen:api-docs": "node scripts/gen-api-docs.mjs",
    "starter-kits:update": "node scripts/update-bundled-starter-kits.mjs",
    "starter-catalog:update": "node scripts/import-starter-catalog.mjs",
    "starter-catalog:check": "node scripts/import-starter-catalog.mjs --check",
    "starter-locales:report": "node scripts/starter-locale-coverage.mjs",
    "starter-kits:check": "node scripts/update-bundled-starter-kits.mjs --check",
    "check:subpaths": "node scripts/check-subpath-deployments.mjs",
    "check:mock-leakage": "node scripts/check-mock-leakage.mjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "21.2.23",
    "@angular/compiler": "21.2.23",
    "@angular/core": "21.2.23",
    "@angular/forms": "21.2.23",
    "@angular/platform-browser": "21.2.23",
    "@angular/router": "21.2.23",
    "@atproto/oauth-client-browser": "^0.5.4",
    "@emoji-mart/data": "^1.2.1",
    "@jsverse/transloco": "^8.4.0",
    "@mozilla/readability": "^0.6.0",
    "badwords-list": "^2.0.1-4",
    "emoji-mart": "^5.6.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.23",
    "@angular-eslint/builder": "^21.0.0",
    "@angular/animations": "21.2.23",
    "@angular/build": "21.2.23",
    "@angular/cli": "21.2.23",
    "@angular/compiler-cli": "21.2.23",
    "@angular/platform-browser-dynamic": "21.2.23",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/angular": "10.6.0",
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "^4.1.9",
    "angular-eslint": "^21.4.0",
    "eslint": "^10.10.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "storybook": "10.6.0",
    "stylelint": "17.15.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.9",
    "zone.js": "0.16.3"
  }
}
