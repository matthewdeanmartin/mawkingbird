# npm has no --only-binary equivalent, so the thing that actually stops a
# native module from compiling here is the `allowScripts` allow-list in
# package.json: an install script that is not listed does not run, so
# node-gyp never fires. Do NOT add a package there without checking it ships
# a prebuilt binary for this platform.
#
# foreground-scripts surfaces install-script output instead of swallowing it,
# so a long compile is visible rather than looking like a hang.
foreground-scripts=true
fund=false
