{
  "id": "./",
  "name": "Mawkingbird",
  "short_name": "Mawkingbird",
  "description": "A free browser client for Mastodon and Bluesky: read your feeds and RSS in one place, and post to both at once.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "theme_color": "#ffffff",
  "background_color": "#ffffff",
  "icons": [
    { "src": "android-chrome-192x192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "android-chrome-512x512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "./share",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
